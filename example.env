# ============================================================
# ROCKSOUL / G4F ENVIRONMENT CONFIGURATION
# g4f 8.4.8
# ============================================================


# ============================================================
# G4F CORE
# ============================================================

# API key untuk akses backend/API g4f jika konfigurasi tersebut digunakan.
# Tidak selalu diperlukan untuk provider yang berjalan tanpa API key.
G4F_API_KEY=

# URL backend alternatif yang digunakan oleh g4f API layer.
# Kosongkan jika menggunakan backend/default behavior.
G4F_BACKEND_URL=

# Timeout koneksi browser yang digunakan oleh fitur/provider
# yang membutuhkan browser automation.
G4F_BROWSER_CONNECTION_TIMEOUT=

# Menentukan apakah browser automation dijalankan headless.
# Nilai umum: true / false
G4F_BROWSER_HEADLESS=false

# Host browser service jika browser dijalankan sebagai service terpisah.
G4F_BROWSER_HOST=

# Port browser service.
G4F_BROWSER_PORT=

# Browser impersonation profile/fingerprint yang digunakan
# oleh HTTP/browser client tertentu.
G4F_BROWSER_IMPERSONATE=

# Daftar origin yang diizinkan oleh CORS.
# Multiple origin dapat dipisahkan dengan koma.
# Contoh:
# http://localhost:3000,http://127.0.0.1:3000
G4F_CORS_ORIGINS=

# Menonaktifkan circuit breaker pada retry provider.
# true / false
# Default behavior: circuit breaker aktif.
G4F_DISABLE_CIRCUIT_BREAKER=false

# URL yang digunakan ketika provider membutuhkan proses login.
G4F_LOGIN_URL=

# Model default yang digunakan oleh konfigurasi global g4f.
# Kosongkan untuk memakai default/provider-selected model.
G4F_MODEL=

# Provider default yang digunakan oleh konfigurasi global g4f.
# Contoh:
# Openai
# Gemini
# Copilot
# Ollama
G4F_PROVIDER=

# Proxy utama yang digunakan oleh g4f.
# Contoh:
# http://127.0.0.1:8080
# socks5://127.0.0.1:1080
G4F_PROXY=

# Timeout request streaming dalam detik.
G4F_STREAM_TIMEOUT=30

# Timeout request umum dalam detik.
G4F_TIMEOUT=30

# Mengaktifkan token optimizer tertentu di g4f.
# Nilai yang didukung mengikuti implementasi g4f.
G4F_TOKEN_OPTIMIZER=

# Mengaktifkan tool emulation.
# true / false
G4F_TOOL_EMULATION=false


# ============================================================
# ANTIGRAVITY
# ============================================================

# Jumlah maksimum percobaan onboarding/authentication.
# Default g4f: 10
ANTIGRAVITY_ONBOARD_ATTEMPTS=10

# Delay antar percobaan onboarding dalam detik.
# Default g4f: 5
ANTIGRAVITY_ONBOARD_DELAY_S=5

# Project ID Google Cloud/Antigravity yang digunakan provider.
# Biasanya hanya diperlukan untuk konfigurasi tertentu.
ANTIGRAVITY_PROJECT_ID=

# Tier Antigravity.
# Default g4f: free-tier
ANTIGRAVITY_TIER_ID=free-tier


# ============================================================
# GOOGLE AUTHENTICATION
# ============================================================

# OAuth Client ID untuk provider yang menggunakan Google OAuth.
GOOGLE_CLIENT_ID=

# OAuth Client Secret untuk provider yang menggunakan Google OAuth.
# SECRET — jangan commit ke Git.
GOOGLE_CLIENT_SECRET=


# ============================================================
# AZURE
# ============================================================

# Azure API endpoint.
# Contoh:
# https://YOUR-RESOURCE.openai.azure.com/
AZURE_API_ENDPOINT=

# API key Azure.
# Bisa berisi lebih dari satu key sesuai format yang diharapkan
# oleh provider Azure.
# SECRET — jangan commit ke Git.
AZURE_API_KEYS=

# Model default Azure.
AZURE_DEFAULT_MODEL=

# Routing configuration Azure.
# Format tergantung konfigurasi/provider g4f.
AZURE_ROUTES=


# ============================================================
# CLAUDE
# ============================================================

# Cookie/auth credential yang digunakan oleh provider Claude.
# SECRET — jangan commit ke Git.
CLAUDE_COOKIE=

# Claude organization ID.
CLAUDE_ORGANIZATION_ID=


# ============================================================
# YUPP
# ============================================================

# Mengaktifkan debug khusus provider Yupp.
# Nilai yang dicek oleh g4f: true / false
DEBUG_MODE=false

# Jumlah error sebelum mekanisme error handling/cooldown Yupp aktif.
# Default g4f: 3
MAX_ERROR_COUNT=3

# Lama cooldown setelah error dalam detik.
# Default g4f: 300
ERROR_COOLDOWN=300

# API key Yupp.
# SECRET — jangan commit ke Git.
YUPP_API_KEY=

# JWT token Yupp.
# SECRET — jangan commit ke Git.
YUPP_JWT=

# Daftar token Yupp.
# Format mengikuti parser token Yupp pada g4f.
# SECRET — jangan commit ke Git.
YUPP_TOKENS=


# ============================================================
# OLLAMA / LOCAL AI
# ============================================================

# Host Ollama.
# Default g4f: localhost
OLLAMA_HOST=localhost

# Port Ollama.
# Default g4f: 11434
OLLAMA_PORT=11434


# ============================================================
# SEARCH
# ============================================================

# URL instance SearXNG yang digunakan provider search.
# Default g4f:
# http://searxng:8080
SEARXNG_URL=http://searxng:8080


# ============================================================
# MCP / GITHUB
# ============================================================

# GitHub token untuk fitur MCP yang membutuhkan akses GitHub.
# SECRET — jangan commit ke Git.
GITHUB_TOKEN=


# ============================================================
# PROXY
# ============================================================

# HTTP proxy global.
# Dapat digunakan sebagai fallback oleh komponen tertentu.
# Contoh:
# http://127.0.0.1:8080
HTTP_PROXY=

# HTTPS proxy global.
# Dapat digunakan sebagai fallback oleh komponen tertentu.
# Contoh:
# http://127.0.0.1:8080
HTTPS_PROXY=


# ============================================================
# BROWSER / SYSTEM
# ============================================================

# Windows roaming application-data directory.
# Biasanya otomatis disediakan Windows.
# Tidak perlu diubah secara manual kecuali ada alasan khusus.
APPDATA=

# Linux/DBus session variable.
# Tidak relevan untuk sebagian besar instalasi Windows.
DBUS_SESSION_BUS_ADDRESS=


# ============================================================
# ROCKSOUL DEVELOPMENT OVERRIDES
# ============================================================

# Mode debug aplikasi/provider.
# Untuk development biasanya:
# DEBUG_MODE=true

# g4f request timeout.
G4F_TIMEOUT=30

# g4f streaming timeout.
G4F_STREAM_TIMEOUT=30

# Proxy utama g4f jika diperlukan.
# Contoh:
# G4F_PROXY=http://127.0.0.1:7890

# Model default.
# G4F_MODEL=

# Provider default.
# G4F_PROVIDER=


# ============================================================
# SECURITY NOTES
# ============================================================

# JANGAN commit file .env yang berisi credential.
#
# Variable yang berpotensi SECRET antara lain:
#
# G4F_API_KEY
# GOOGLE_CLIENT_SECRET
# AZURE_API_KEYS
# CLAUDE_COOKIE
# YUPP_API_KEY
# YUPP_JWT
# YUPP_TOKENS
# GITHUB_TOKEN
#
# Gunakan .env.example untuk template tanpa credential.